# DraftMate.ai — Environment Configuration Template
# NOTE: DraftMate.ai runs 100% locally out-of-the-box in deterministic demo mode.
# No external API keys are required to run the demo or test the complete verification suite.

# Optional: Google Gemini API (if enabling live LLM draft generation)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API (if enabling live OpenAI models)
# VITE_OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default AI Provider ("offline_deterministic" | "gemini" | "openai")
VITE_DEFAULT_AI_PROVIDER=offline_deterministic

# Local Server Port (default: 5173)
PORT=5173
